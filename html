<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>
</head>
<body>

    <header>
        <h1>Task Manager</h1>
        <p>Aplikasi sederhana untuk mengelola tugas harian.</p>
    </header>

    <nav aria-label="Navigasi utama">
        <a href="#ringkasan">Ringkasan</a>
        <a href="#daftar-tugas">Daftar Tugas</a>
        <a href="#tambah-tugas">Tambah Tugas</a>
    </nav>

    <main>
        <section id="ringkasan">
            <h2>Ringkasan Tugas</h2>
            <article>
                <h3>Tugas 1</h3>
                <p>Ringkasan dari semua tugas yang telah ditambahkan.</p>
            </article>
            <article>
                <h3>Tugas 2</h3>
                <p>Statistik mengenai jumlah tugas yang telah selesai dan yang masih pending.</p>
            </article>
            <article>
                <h3>Tugas 3</h3>
                <p>Notifikasi untuk tugas yang mendekati tenggat waktu.</p> 
            </article>
        </section>

        <section id="daftar-tugas">
            <h2>Daftar Tugas</h2>
            <table border="1">
                <caption style="color: darkgreen;">Daftar Tugas Harian</caption>
                <thead>
                    <tr>
                        <th scope="col">Nomer</th>
                        <th scope="col">Nama Tugas</th>
                        <th scope="col">Prioritas</th>
                        <th scope="col">Status</th>
                        <th scope="col">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Membuat Halaman HTML</td>
                        <td>High</td>
                        <td>progress</td>
                        <td>
                            <button>Edit</button>
                            <button>Hapus</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Menulis Dokumentasi</td>
                        <td>Medium</td>
                        <td>Selesai</td>
                        <td>
                            <button>Edit</button>
                            <button>Hapus</button>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Membuat Formulir Input</td>
                        <td>Low</td>
                        <td>belum Selesai</td>
                        <td>
                            <button>Edit</button>
                            <button>Hapus</button>
                        </td>
                </tbody>
            </table>
        </section>

        <section id="tambah-tugas">
            <h2>Tambah Tugas</h2>
            <form action="#" method="post">
                <p>
                <label for="nama-tugas">Nama Tugas:</label>
                <input type="text" id="nama-tugas" name="nama-tugas" required>
                </p>
                
                <p>
                <label for="prioritas">Prioritas:</label>
                <select id="prioritas" name="prioritas" required>
                    <option value="">Pilih Prioritas</option>
                    <option value="high">High</option>
                    <option value="medium">Medium</option>
                    <option value="low">Low</option>
                </select>
                </p>

                <p> 
                <label for="status">Status:</label>
                <select id="status" name="status" required>
                    <option value="">Pilih Status</option>
                    <option value="belum selesai">Belum Selesai</option>
                    <option value="progress">Progress</option>
                    <option value="selesai">Selesai</option>
                </select>
                </p>

                <button type="submit">Tambah Tugas</button>
            </form>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Rangger Merahs</p>
    </footer>

</body>
</html>